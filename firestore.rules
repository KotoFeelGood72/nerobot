rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creator == request.auth.uid;
      allow update: if request.auth != null && (
        // Заказчик может менять любые поля своего заказа
        resource.data.creator == request.auth.uid
        // Исполнитель может только добавить себя в responses (отклик)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses'])
        // Назначенный исполнитель может сменить статус на preview (сдано на проверку)
        || (
          resource.data.workers is list
          && request.auth.uid in resource.data.workers
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'preview'
        )
      );
      allow delete: if request.auth != null
                    && resource.data.creator == request.auth.uid;
    }

    // RESPONSES
    match /responses/{responseId} {
      allow create: if request.auth != null
                    && request.resource.data.respondent == request.auth.uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.respondent == request.auth.uid;
      allow delete: if false;
    }

    // CHATS
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
    }

    // FEEDBACKS (обратная связь в поддержку)
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // REVIEWS (отзывы об исполнителях / пользователях)
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.from_user == request.auth.uid
                    && request.resource.data.to_user is string
                    && request.resource.data.to_user != request.auth.uid;
      allow update, delete: if false;
    }

    // DEBUG
    match /debug_connect/{docId} {
      allow read, write: if request.auth != null;
    }

    // Email OTP / outbound mail — только Admin SDK / Cloud Functions
    match /email_otps/{docId} {
      allow read, write: if false;
    }
    match /mail/{docId} {
      allow read, write: if false;
    }
  }
}
